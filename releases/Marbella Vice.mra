<misterromdescription>
    <name>Marbella Vice</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <setname>Picmatic</setname>
    <year>1994</year>
    <manufacturer>Picmatic</manufacturer>
    <category>LaserDisc / Shooter</category>
    <rbf>Picmatic</rbf>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <players>2</players>
    <special_controls>lightgun</special_controls>
    <num_buttons>5</num_buttons>

    <!-- Same files as the WinUAE set (rommgr id 302). The disc goes in through the OSD:
         "Mount LaserDisc" -> a .dlv made with tools/avi2dlv.py from the PAL capture. -->
    <!-- ioctl index 0 = rtl/uio_boot.sv layout: Kickstart 1.3 at $F80000 and $FC0000, game ROM at $F00000 -->
    <rom index="0" zip="marbvice.zip|kick13.zip" md5="none">
        <part name="amiga-os-130.rom" crc="c4f0f55f"/>
        <part name="amiga-os-130.rom" crc="c4f0f55f"/>
        <interleave output="16">
            <part name="picmatic_mv_u2.bin" crc="01c9a503" map="01"/>
            <part name="picmatic_mv_u1.bin" crc="78eb6fd6" map="10"/>
        </interleave>
    </rom>

    <nvram index="4" size="4096"/>
</misterromdescription>
